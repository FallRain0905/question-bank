# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 千问 AI 配置
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# DeepSeek AI 配置
DEEPSEEK_API_KEY=

# Kimi / Moonshot AI 配置（可选）
KIMI_API_KEY=
MOONSHOT_API_KEY=

# 自定义 OpenAI 兼容模型配置（可选）
OPENAI_API_KEY=

# 嵌入模型配置（可选，用户设置留空时使用）
EMBEDDING_API_KEY=
SILICONFLOW_API_KEY=
HYPERRAG_SERVICE_URL=

# Research web crawler sidecar
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
CRAWL_SERVICE_URL=http://localhost:8002

# MinerU API 配置（PDF 转 Markdown）
MINERU_API_TOKEN=

# 独立学习 API（Phase 1，知识库/RAG 问答使用）
# 本地开发默认 http://127.0.0.1:4000；生产环境应指向同域代理路径或独立域名
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# 仅在服务端设置了 API_ACCESS_TOKEN 时需要；注意 NEXT_PUBLIC_* 会暴露给浏览器
NEXT_PUBLIC_API_ACCESS_TOKEN=

# Nextcloud 配置（可选，用于背景图片上传）
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_PUBLIC_URL=
