{
  "name": "question-bank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api:dev": "tsx watch api/src/main.ts",
    "api:build": "tsc -p tsconfig.api.json",
    "api:start": "node dist/api/main.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:prod": "node dist/api/database/migrate.js",
    "api:compose:up": "docker compose -f docker-compose.phase1.yml up -d",
    "api:compose:down": "docker compose -f docker-compose.phase1.yml down",
    "arxiv:cron": "tsx scripts/arxiv-cron.ts",
    "synapse:worker": "tsx scripts/synapse-run-worker.ts",
    "test": "vitest run",
    "lint": "next lint"
  },
