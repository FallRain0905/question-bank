# Independent Phase 1 API settings
API_HOST=127.0.0.1
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DATABASE_POOL_MAX=10

# Optional bearer token gate for the API (uploads, embeddings, LLM calls).
# Leave empty for local development; set a long random value before exposing
# the API outside the machine. Replace with Better Auth sessions later.
API_ACCESS_TOKEN=

# Knowledge base upload limit in megabytes
KB_MAX_UPLOAD_MB=30

# Database (Docker Compose defaults)
DATABASE_URL=postgresql://learning:learning_dev@localhost:5432/learning

# Object storage (Docker Compose defaults; not wired into the API yet)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=learning-files

# Queue (Docker Compose defaults; worker lands later in Phase 1)
REDIS_URL=redis://localhost:6379

# Embeddings. Without a key the API falls back to a deterministic local-hash
# vector, which is only good enough for pipeline testing.
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# Must match the pgvector column dimension (VECTOR_DIMENSIONS in api/src/database/schema.ts)
EMBEDDING_DIMENSIONS=2560
# Send the dimensions field only if your provider supports it
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=16
# EMBEDDING_PROVIDER=openai-compatible | local-hash

# Chat model for RAG answers. Any OpenAI-compatible endpoint works.
LLM_API_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# LLM_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=
# SILICONFLOW_API_KEY=
